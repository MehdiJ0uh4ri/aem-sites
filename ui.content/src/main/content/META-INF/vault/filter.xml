<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">
    <filter root="/conf/mysite" mode="merge"/>
    <filter root="/content/mysite" mode="merge"/>
    <filter root="/content/dam/mysite" mode="merge">
        <exclude pattern="/content/dam/mysite(/.*)?"/>
        <include pattern="/content/dam/mysite/jcr:content(/.*)?"/>
    </filter>
    <filter root="/content/dam/mysite/asset.jpg" mode="merge"/>
    <filter root="/content/experience-fragments/mysite" mode="merge"/>

    <!--
        MJ & Company. A second site on the same component library: its own configuration,
        its own content, its own fragments.

        The import modes are not uniform, and the difference matters:

          /conf/mjco        update  - templates, policies and fragment models are part of
                                      the delivery. Under merge a corrected model never
                                      reaches an instance that already has the old one,
                                      which is precisely how a broken model survived three
                                      deployments here.
          /content/dam/mjco update  - seed fragments and imagery are delivered too, so a
                                      corrected or extended fragment refreshes on deploy.
          /content/mjco     merge   - pages are authored in AEM. Dialog values set by an
                                      author must survive a redeploy, so this one stays
                                      merge and the seed page is only ever a starting point.

        update adds and refreshes nodes without deleting anything the author added.
    -->
    <filter root="/conf/mjco" mode="update"/>
    <filter root="/content/dam/mjco" mode="update"/>
    <filter root="/content/mjco/us/en/approach" mode="update"/>
    <filter root="/content/mjco/us/en/portfolio" mode="update"/>
    <filter root="/content/mjco/us/en/market-intelligence" mode="update"/>
    <filter root="/content/mjco" mode="merge"/>
    <!--
        Pages the project delivers rather than pages an author composes. merge leaves an
        existing node alone and does not descend into it to add children, so a section page
        that already exists never receives a revised composition. These two are part of the
        build and are declared update; the homepage stays merge because it is authored.
    -->
</workspaceFilter>
