<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/mjco/settings/wcm/templates/mjco-section"
        jcr:primaryType="cq:PageContent"
        navTitle="Market Intelligence"
        jcr:title="Market Intelligence"
        pageTitle="Market Intelligence | MJ &amp; Company"
        jcr:description="Quarterly figures MJ &amp; Company tracks, each published with its source and our reading of it."
        sling:resourceType="mysite/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="mysite/components/container"
            layout="responsiveGrid">
            <sections
                jcr:primaryType="nt:unstructured"
                sling:resourceType="mysite/components/container"
                layout="responsiveGrid">
                <opener
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjhero"
                    eyebrow="Market intelligence"
                    lineOne="Figures, and"
                    lineTwo="what we read into them."
                    standfirst="Published quarterly. Every figure carries a source, and every source is one we would defend in a partner meeting."/>
                <band
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjmarket"
                    parentPath="/content/dam/mjco/market"
                    limit="{Long}12"/>
            </sections>
        </root>
    </jcr:content>
</jcr:root>
