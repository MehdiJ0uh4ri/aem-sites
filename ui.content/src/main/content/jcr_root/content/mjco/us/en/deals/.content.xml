<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/mjco/settings/wcm/templates/mjco-section"
        jcr:primaryType="cq:PageContent"
        navTitle="Deals"
        jcr:title="Deals"
        pageTitle="Deals | MJ &amp; Company"
        jcr:description="A record of MJ &amp; Company financings: company, date, sector and investment type."
        sling:resourceType="mysite/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="mysite/components/container"
            layout="responsiveGrid">
            <sections
                jcr:primaryType="nt:unstructured"
                sling:resourceType="mysite/components/container"
                layout="responsiveGrid">
                <opener
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjhero"
                    eyebrow="Deals"
                    lineOne="The record,"
                    lineTwo="without the narrative."
                    standfirst="Financings as they happened. The reasoning behind them lives in the insights and case studies these entries link to."/>
                <index
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjindex"
                    variant="deals"
                    parentPath="/content/dam/mjco/deals"
                    detailRoot="/content/mjco/us/en/deals"
                    limit="{Long}48"/>
            </sections>
        </root>
    </jcr:content>
</jcr:root>
