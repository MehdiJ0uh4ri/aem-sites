<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/mjco/settings/wcm/templates/mjco-section"
        jcr:primaryType="cq:PageContent"
        navTitle="Investment Approach"
        jcr:title="Investment Approach"
        pageTitle="Investment Approach | MJ &amp; Company"
        jcr:description="How MJ &amp; Company selects, sizes and holds positions: the beliefs, the sectors and the ownership strategy behind the portfolio."
        sling:resourceType="mysite/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="mysite/components/container"
            layout="responsiveGrid">
            <sections
                jcr:primaryType="nt:unstructured"
                sling:resourceType="mysite/components/container"
                layout="responsiveGrid">
                <opener
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjhero"
                    eyebrow="Investment approach"
                    lineOne="We buy fewer things,"
                    lineTwo="and we write down why."
                    standfirst="Concentration, a written thesis for every position, and a second cheque that has to be argued for again. Placeholder copy — replace with MJ &amp; Company’s own statement before publication."
                    scrollCue="Scroll"/>
                <beliefs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjthesis"
                    eyebrow="What we believe"
                    heading="Four positions we will be measured against."
                    parentPath="/content/dam/mjco/thesis"/>
                <sectors
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjindex"
                    variant="sectors"
                    eyebrow="Where we invest"
                    heading="Five sectors, and the reasoning in each."
                    intro="We are not sector-agnostic. Each of these was entered with a thesis that can be shown to have held or broken."
                    parentPath="/content/dam/mjco/sectors"
                    limit="{Long}6"/>
                <practice
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjfeature"
                    variant="casestudy"
                    eyebrow="The approach in practice"
                    fragmentPath="/content/dam/mjco/case-studies/caldera-grid"
                    fileReferenceOverride="/content/dam/mjco/images/case-caldera-full.jpg"
                    ctaText="Read the case study"
                    ctaLink="/content/mjco/us/en/case-studies/caldera-grid"/>
                <strategy
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjsignal"
                    eyebrow="How we hold"
                    statement="Ownership is decided in the first cheque and defended in every one after it."
                    footnote="Placeholder figures. Replace with verified firm data before publication.">
                    <items jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            value="00%"
                            label="Target ownership"
                            note="Placeholder"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            value="$0–00M"
                            label="Initial cheque"
                            note="Placeholder"/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            value="Seed–A"
                            label="Entry stage"
                            note="Placeholder"/>
                        <item3
                            jcr:primaryType="nt:unstructured"
                            value="00%"
                            label="Reserved for follow-on"
                            note="Placeholder"/>
                    </items>
                </strategy>
                <related
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjrelated"
                    eyebrow="Follow the thread"
                    heading="Where this thinking leads."
                    fragmentPath="/content/dam/mjco/thesis/underwrite-the-operator"
                    basePath="/content/mjco/us/en"
                    limit="{Long}6"/>
                <engage
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="mysite/components/mjengage"
                    eyebrow="Engage"
                    statement="If your thesis disagrees with ours, that is the more interesting conversation.">
                    <items jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            audience="Founders"
                            body="Send the argument, not the deck."
                            ctaText="Write to us"
                            ctaLink="/content/mjco/us/en/engage"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            audience="Investors"
                            body="Our reporting and our marks are available to prospective limited partners."
                            ctaText="Request materials"
                            ctaLink="/content/mjco/us/en/engage"/>
                    </items>
                </engage>
            </sections>
        </root>
    </jcr:content>
</jcr:root>
