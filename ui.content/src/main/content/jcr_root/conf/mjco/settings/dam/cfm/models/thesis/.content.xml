<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Thesis"
        jcr:description="One belief the firm holds and the reasoning under it. The anchor of the content graph: sectors, portfolio companies and insights all hang off a thesis, which is why this is a fragment rather than page copy."
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <model
            jcr:primaryType="nt:unstructured"
            sling:resourceType="dam/cfm/models/console/components/data/entity/default">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container">
                    <items jcr:primaryType="nt:unstructured">
                        <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Belief"
                            name="title"
                            valueType="string"
                            metaType="text-single"
                            renderType="text"
                            listOrder="{Long}1"
                            fieldDescription="Stated as a claim someone could disagree with."
                            required="{Boolean}true"/>
                        <slug
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Slug"
                            name="slug"
                            valueType="string"
                            metaType="text-single"
                            renderType="text"
                            listOrder="{Long}2"
                            fieldDescription="URL segment. Defaults to the fragment name when empty."/>
                        <ordinal
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Number"
                            name="ordinal"
                            valueType="string"
                            metaType="text-single"
                            renderType="text"
                            listOrder="{Long}3"
                            fieldDescription="Optional. Left empty the component numbers the list itself."/>
                        <statement
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Statement"
                            name="statement"
                            valueType="string/multiline"
                            metaType="text-multi"
                            renderType="text"
                            listOrder="{Long}4"
                            fieldDescription="The belief in one or two sentences."/>
                        <rationale
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Rationale"
                            name="rationale"
                            valueType="string/multiline"
                            metaType="text-multi"
                            renderType="text"
                            listOrder="{Long}5"
                            fieldDescription="Why the firm holds it. This is the part that has to be arguable."/>
                        <relatedSectors
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Related sectors"
                            name="relatedSectors"
                            valueType="string/content-fragment[]"
                            metaType="fragment-reference"
                            renderType="text"
                            listOrder="{Long}6"
                            multiple="{Boolean}true"/>
                        <relatedPortfolio
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Related portfolio companies"
                            name="relatedPortfolio"
                            valueType="string/content-fragment[]"
                            metaType="fragment-reference"
                            renderType="text"
                            listOrder="{Long}7"
                            multiple="{Boolean}true"/>
                        <relatedInsights
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Related insights"
                            name="relatedInsights"
                            valueType="string/content-fragment[]"
                            metaType="fragment-reference"
                            renderType="text"
                            listOrder="{Long}8"
                            multiple="{Boolean}true"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
