<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Deal"
        jcr:description="One financing. Deliberately thin: a deal is a fact, and anything discursive belongs in the case study that references it."
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <model
            jcr:primaryType="nt:unstructured"
            sling:resourceType="dam/cfm/models/console/components/data/entity/default">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container">
                    <items jcr:primaryType="nt:unstructured">
                        <company
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Company"
                            name="company"
                            valueType="string"
                            metaType="text-single"
                            renderType="text"
                            listOrder="{Long}1"
                            required="{Boolean}true"/>
                        <slug
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Slug"
                            name="slug"
                            valueType="string"
                            metaType="text-single"
                            renderType="text"
                            listOrder="{Long}2"/>
                        <date
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/datepicker"
                            fieldLabel="Date"
                            name="date"
                            valueType="calendar/datetime"
                            metaType="date-time"
                            renderType="datepicker"
                            listOrder="{Long}3"/>
                        <investmentType
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Investment type"
                            name="investmentType"
                            valueType="string"
                            metaType="text-single"
                            renderType="text"
                            listOrder="{Long}4"
                            fieldDescription="Seed, Series A, Series B, Follow-on."/>
                        <sector
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Sector"
                            name="sector"
                            valueType="string"
                            metaType="text-single"
                            renderType="text"
                            listOrder="{Long}5"/>
                        <description
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Description"
                            name="description"
                            valueType="string/multiline"
                            metaType="text-multi"
                            renderType="text"
                            listOrder="{Long}6"
                            fieldDescription="One line. The ledger has room for one line."/>
                        <relatedContent
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/datatypes/field"
                            fieldLabel="Related content"
                            name="relatedContent"
                            valueType="string/content-fragment[]"
                            metaType="fragment-reference"
                            renderType="text"
                            listOrder="{Long}7"
                            multiple="{Boolean}true"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
