<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template">
    <jcr:content
        jcr:primaryType="nt:unstructured"
        jcr:title="Deal"
        jcr:description="One financing. Deliberately thin: a deal is a fact, and anything discursive belongs in the case study that references it."
        sling:resourceType="dam/cfm/models/console/components/data/entity"
        status="enabled">
        <model
            jcr:primaryType="nt:unstructured"
            sling:resourceType="dam/cfm/models/console/components/data/entity/default">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <company
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Company"
                        name="company"
                        valueType="string"
                        metaType="text-single"
                        listOrder="{Long}1"
                        required="{Boolean}true"/>
                    <slug
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Slug"
                        name="slug"
                        valueType="string"
                        metaType="text-single"
                        listOrder="{Long}2"/>
                    <date
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                        fieldLabel="Date"
                        name="date"
                        valueType="string"
                        metaType="date-time"
                        listOrder="{Long}3"/>
                    <investmentType
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Investment type"
                        name="investmentType"
                        valueType="string"
                        metaType="text-single"
                        listOrder="{Long}4"
                        fieldDescription="Seed, Series A, Series B, Follow-on."/>
                    <sector
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Sector"
                        name="sector"
                        valueType="string"
                        metaType="text-single"
                        listOrder="{Long}5"/>
                    <description
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                        fieldLabel="Description"
                        name="description"
                        valueType="string"
                        metaType="text-multi"
                        listOrder="{Long}6"
                        fieldDescription="One line. The ledger has room for one line."/>
                    <relatedContent
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Related content"
                        name="relatedContent"
                        valueType="string[]"
                        metaType="fragment-reference"
                        listOrder="{Long}7"
                        multiple="{Boolean}true"/>
                </items>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
