<?xml version="1.0" encoding="UTF-8"?>
<!--
 | Publication workflow for any page carrying technical specifications, performance figures
 | or programme imagery.
 |
 | The order of the steps is the point. Comms and Legal review the wording; Export Control
 | reviews the figures; only then does the automated gate run, and only then does the page
 | activate. The gate is a process step rather than a note in a dialog because an author
 | cannot decline to run it — it fails the workflow, and the page stays unpublished.
 |
 | The gate does not grant clearance. It verifies that a named reviewer recorded one on the
 | page's Export Control tab and writes the audit record. Clearance stays a human act.
-->
<jcr:root xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:lastModified="{Date}2026-03-01T09:00:00.000+01:00"
        cq:template="/libs/cq/workflow/templates/model"
        jcr:primaryType="cq:PageContent"
        jcr:title="AeroVance — Technical Content Publication"
        sling:resourceType="cq/workflow/components/pages/model">
        <flow
            jcr:primaryType="nt:unstructured"
            sling:resourceType="foundation/components/parsys"/>
        <model
            jcr:primaryType="cq:WorkflowModel"
            description="Comms and Legal review, then mandatory export-control review, then publication. Required for any page carrying specifications, performance figures or programme imagery."
            sling:resourceType="cq/workflow/components/model">
            <metaData
                jcr:primaryType="nt:unstructured"
                cq:generatingWorkflowModel="/var/workflow/models/aerovance-export-control-publication"/>
            <nodes jcr:primaryType="nt:unstructured">
                <node0
                    jcr:primaryType="cq:WorkflowNode"
                    title="Start"
                    type="START">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </node0>
                <node1
                    jcr:primaryType="cq:WorkflowNode"
                    description="Review the page copy, headlines and press wording."
                    title="Comms review"
                    type="PARTICIPANT">
                    <metaData
                        jcr:primaryType="nt:unstructured"
                        PARTICIPANT="aerovance-comms"
                        DO_NOT_SEND_EMAIL="{Boolean}false"/>
                </node1>
                <node2
                    jcr:primaryType="cq:WorkflowNode"
                    description="Legal sign-off. Required for press releases and investor-relations documents."
                    title="Legal review"
                    type="PARTICIPANT">
                    <metaData
                        jcr:primaryType="nt:unstructured"
                        PARTICIPANT="aerovance-legal"
                        DO_NOT_SEND_EMAIL="{Boolean}false"/>
                </node2>
                <node3
                    jcr:primaryType="cq:WorkflowNode"
                    description="Assign the export-control classification on the page's Export Control tab and record the clearance. The next step verifies it and will fail without it."
                    title="Export control review"
                    type="PARTICIPANT">
                    <metaData
                        jcr:primaryType="nt:unstructured"
                        PARTICIPANT="aerovance-export-control"
                        DO_NOT_SEND_EMAIL="{Boolean}false"/>
                </node3>
                <node4
                    jcr:primaryType="cq:WorkflowNode"
                    description="Verifies the recorded clearance and writes the audit record. Fails the workflow if the review was not completed."
                    title="Export control gate"
                    type="PROCESS">
                    <metaData
                        jcr:primaryType="nt:unstructured"
                        PROCESS="com.mysite.core.workflows.ExportControlGateProcess"
                        PROCESS_AUTO_ADVANCE="{Boolean}true"/>
                </node4>
                <node5
                    jcr:primaryType="cq:WorkflowNode"
                    description="Activates the page."
                    title="Publish"
                    type="PROCESS">
                    <metaData
                        jcr:primaryType="nt:unstructured"
                        PROCESS="com.day.cq.wcm.workflow.process.ActivatePageProcess"
                        PROCESS_AUTO_ADVANCE="{Boolean}true"/>
                </node5>
                <node6
                    jcr:primaryType="cq:WorkflowNode"
                    title="End"
                    type="END">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </node6>
            </nodes>
            <transitions jcr:primaryType="nt:unstructured">
                <transition0
                    jcr:primaryType="cq:WorkflowTransition"
                    from="node0"
                    rule=""
                    to="node1">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </transition0>
                <transition1
                    jcr:primaryType="cq:WorkflowTransition"
                    from="node1"
                    rule=""
                    to="node2">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </transition1>
                <transition2
                    jcr:primaryType="cq:WorkflowTransition"
                    from="node2"
                    rule=""
                    to="node3">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </transition2>
                <transition3
                    jcr:primaryType="cq:WorkflowTransition"
                    from="node3"
                    rule=""
                    to="node4">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </transition3>
                <transition4
                    jcr:primaryType="cq:WorkflowTransition"
                    from="node4"
                    rule=""
                    to="node5">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </transition4>
                <transition5
                    jcr:primaryType="cq:WorkflowTransition"
                    from="node5"
                    rule=""
                    to="node6">
                    <metaData jcr:primaryType="nt:unstructured"/>
                </transition5>
            </transitions>
        </model>
    </jcr:content>
</jcr:root>
