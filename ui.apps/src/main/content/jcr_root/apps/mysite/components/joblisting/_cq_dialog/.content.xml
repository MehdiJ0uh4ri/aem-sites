<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Job Listing Grid"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <note
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/text"
                        text="Roles come live from the applicant tracking system. The filter options are built from the openings that actually exist, so there is nothing to maintain here when an office opens or closes."/>
                    <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Optional heading rendered above the results."
                        fieldLabel="Heading"
                        name="./heading"/>
                    <headingElement
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldDescription="HTML element used for the heading. Pick the one that fits the page outline."
                        fieldLabel="Heading element"
                        name="./headingElement">
                        <items jcr:primaryType="nt:unstructured">
                            <h2
                                jcr:primaryType="nt:unstructured"
                                selected="{Boolean}true"
                                text="H2"
                                value="h2"/>
                            <h3
                                jcr:primaryType="nt:unstructured"
                                text="H3"
                                value="h3"/>
                        </items>
                    </headingElement>
                    <fixedFunction
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Pins the component to one job family, exactly as the ATS names it — for example: Structures Engineering. Use this on a business-unit careers page so it never lists roles from elsewhere in the company. Leave empty to show every family and offer the job-family filter."
                        fieldLabel="Restrict to job family"
                        name="./fixedFunction"/>
                    <pageSize
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                        fieldDescription="Roles per page. Defaults to 20; the applicant tracking system will not return more than 100."
                        fieldLabel="Results per page"
                        max="{Long}100"
                        min="{Long}1"
                        name="./pageSize"
                        typeHint="Long"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
