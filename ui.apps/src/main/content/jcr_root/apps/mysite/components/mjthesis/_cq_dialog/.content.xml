<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="MJ Thesis"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container"
        margin="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <headingLevel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldDescription="Auto gives the h1 to whichever section opens the page and h2 to every section after it. Override only to correct a heading outline."
                        fieldLabel="Heading level"
                        name="./headingLevel">
                        <items jcr:primaryType="nt:unstructured">
                            <auto
                                jcr:primaryType="nt:unstructured"
                                selected="{Boolean}true"
                                text="Auto"
                                value=""/>
                            <h1 jcr:primaryType="nt:unstructured" text="H1" value="h1"/>
                            <h2 jcr:primaryType="nt:unstructured" text="H2" value="h2"/>
                            <h3 jcr:primaryType="nt:unstructured" text="H3" value="h3"/>
                        </items>
                    </headingLevel>
                    <eyebrow
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Eyebrow"
                name="./eyebrow"/>
            <heading
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Heading"
                name="./heading"/>
            <parentPath
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldDescription="Optional. A folder of Thesis fragments, used instead of the beliefs typed below — pick this when the beliefs are referenced by sectors or companies elsewhere on the site."
                fieldLabel="Thesis fragment folder"
                name="./parentPath"
                rootPath="/content/dam"/>
            <items
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                composite="{Boolean}true"
                fieldDescription="Three to five beliefs. Each one should be arguable — a statement no reasonable firm would disagree with is not a thesis."
                fieldLabel="Beliefs">
                <field
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container"
                    name="./items">
                    <items jcr:primaryType="nt:unstructured">
                        <ordinal
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldDescription="Leave empty to number automatically. Reordering the list renumbers it."
                            fieldLabel="Number"
                            name="./ordinal"/>
                        <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Belief"
                            name="./title"/>
                        <body
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            fieldLabel="Reasoning"
                            name="./body"
                            rows="{Long}3"/>
                    </items>
                </field>
            </items>
        </items>
    </content>
</jcr:root>
