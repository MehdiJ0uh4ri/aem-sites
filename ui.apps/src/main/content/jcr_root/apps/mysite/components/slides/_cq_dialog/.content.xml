<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Slides"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <intro
                jcr:primaryType="nt:unstructured"
                jcr:title="Intro"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <eyebrow
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Eyebrow"
                        name="./eyebrow"/>
                    <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Heading"
                        name="./heading"/>
                    <description
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                        fieldLabel="Description"
                        name="./description"
                        rows="{Long}3"/>
                    <layout
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldDescription="Split alternates artwork and copy side by side. Spotlight overlays the copy on full-bleed artwork. Cards scrolls a row of smaller tiles."
                        fieldLabel="Layout"
                        name="./layout">
                        <items jcr:primaryType="nt:unstructured">
                            <split
                                jcr:primaryType="nt:unstructured"
                                selected="{Boolean}true"
                                text="Split"
                                value="split"/>
                            <spotlight
                                jcr:primaryType="nt:unstructured"
                                text="Spotlight"
                                value="spotlight"/>
                            <cards
                                jcr:primaryType="nt:unstructured"
                                text="Cards"
                                value="cards"/>
                        </items>
                    </layout>
                </items>
            </intro>
            <slidestab
                jcr:primaryType="nt:unstructured"
                jcr:title="Slides"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <slides
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="{Boolean}true"
                        fieldDescription="Each entry becomes one slide."
                        fieldLabel="Slides">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./slides">
                            <items jcr:primaryType="nt:unstructured">
                                <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Title"
                                    name="./title"/>
                                <description
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Description"
                                    name="./description"
                                    rows="{Long}3"/>
                                <fileReference
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Image"
                                    name="./fileReference"
                                    rootPath="/content/dam"/>
                                <alt
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="Leave empty when the image is decorative."
                                    fieldLabel="Alternative text"
                                    name="./alt"/>
                                <ctaText
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Button label"
                                    name="./ctaText"/>
                                <ctaLink
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldDescription="Tracked as this slide's link in the Adobe Client Data Layer."
                                    fieldLabel="Button link"
                                    name="./ctaLink"
                                    rootPath="/content"/>
                            </items>
                        </field>
                    </slides>
                </items>
            </slidestab>
        </items>
    </content>
</jcr:root>
