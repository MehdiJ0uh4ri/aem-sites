<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="MJ Investment Signal"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <statement
                jcr:primaryType="nt:unstructured"
                jcr:title="Statement"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <eyebrow
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Eyebrow"
                        name="./eyebrow"/>
                    <statement
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                        fieldDescription="The claim the figures below are evidence for. This is the section's heading — write it as a sentence, not a label."
                        fieldLabel="Statement"
                        name="./statement"
                        required="{Boolean}true"
                        rows="{Long}3"/>
                    <footnote
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Source or as-of note printed under the ledger."
                        fieldLabel="Footnote"
                        name="./footnote"/>
                </items>
            </statement>
            <ledger
                jcr:primaryType="nt:unstructured"
                jcr:title="Ledger"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <items
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="{Boolean}true"
                        fieldDescription="Three or four figures read best. Beyond that the band becomes a dashboard."
                        fieldLabel="Figures">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./items">
                            <items jcr:primaryType="nt:unstructured">
                                <value
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="Set at display size, e.g. $410M or 24."
                                    fieldLabel="Figure"
                                    name="./value"/>
                                <label
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Label"
                                    name="./label"/>
                                <note
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="Optional qualifier, e.g. committed since 2019."
                                    fieldLabel="Note"
                                    name="./note"/>
                            </items>
                        </field>
                    </items>
                </items>
            </ledger>
        </items>
    </content>
</jcr:root>
