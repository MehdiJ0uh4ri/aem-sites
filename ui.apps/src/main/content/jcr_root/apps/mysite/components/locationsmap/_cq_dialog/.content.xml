<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Global Locations Map"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <map
                jcr:primaryType="nt:unstructured"
                jcr:title="Map"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Optional heading rendered above the map."
                        fieldLabel="Heading"
                        name="./heading"/>
                    <headingElement
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldDescription="HTML element used for the heading. Pick the one that fits the page outline."
                        fieldLabel="Heading element"
                        name="./headingElement">
                        <items jcr:primaryType="nt:unstructured">
                            <h2
                                jcr:primaryType="nt:unstructured"
                                selected="{Boolean}true"
                                text="H2"
                                value="h2"/>
                            <h3
                                jcr:primaryType="nt:unstructured"
                                text="H3"
                                value="h3"/>
                        </items>
                    </headingElement>
                    <baseMap
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="World map from Assets. It must be an equirectangular (plate carree) projection covering the full globe: pins are placed by a linear mapping of latitude and longitude, and any other projection will put them in the wrong place. Leave empty to render the facilities as a list only."
                        fieldLabel="Base map"
                        name="./baseMap"
                        rootPath="/content/dam"/>
                </items>
            </map>
            <facilities
                jcr:primaryType="nt:unstructured"
                jcr:title="Facilities"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <locations
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="{Boolean}true"
                        fieldDescription="Facilities without a name are not rendered. A facility with no coordinates is still listed, just not pinned."
                        fieldLabel="Facilities">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./locations">
                            <items jcr:primaryType="nt:unstructured">
                                <name
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="For example: Toulouse Final Assembly Line."
                                    fieldLabel="Facility name"
                                    name="./name"
                                    required="{Boolean}true"/>
                                <businessUnit
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldDescription="Drives the filter above the map. Only units that have a facility here are offered as filters."
                                    fieldLabel="Business unit"
                                    name="./businessUnit">
                                    <items jcr:primaryType="nt:unstructured">
                                        <none
                                            jcr:primaryType="nt:unstructured"
                                            selected="{Boolean}true"
                                            text="Not assigned"
                                            value=""/>
                                        <commercial
                                            jcr:primaryType="nt:unstructured"
                                            text="Commercial Aviation"
                                            value="commercial-aviation"/>
                                        <defence
                                            jcr:primaryType="nt:unstructured"
                                            text="Defence &amp; Space"
                                            value="defence-space"/>
                                        <mro
                                            jcr:primaryType="nt:unstructured"
                                            text="MRO &amp; Services"
                                            value="mro-services"/>
                                        <digital
                                            jcr:primaryType="nt:unstructured"
                                            text="Digital &amp; Autonomous Systems"
                                            value="digital-autonomous"/>
                                        <corporate
                                            jcr:primaryType="nt:unstructured"
                                            text="Corporate"
                                            value="corporate"/>
                                    </items>
                                </businessUnit>
                                <facilityType
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="What the site does, for example: Final assembly, Wind tunnel, MRO centre."
                                    fieldLabel="Facility type"
                                    name="./facilityType"/>
                                <city
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="City"
                                    name="./city"/>
                                <country
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Country"
                                    name="./country"/>
                                <address
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldDescription="Postal address. Line breaks are preserved as typed."
                                    fieldLabel="Address"
                                    name="./address"
                                    rows="{Long}4"/>
                                <latitude
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldDescription="Decimal degrees, north positive. Between -90 and 90; outside that range the facility is listed but not pinned."
                                    fieldLabel="Latitude"
                                    max="{Double}90"
                                    min="{Double}-90"
                                    name="./latitude"
                                    step="0.0001"
                                    typeHint="Double"/>
                                <longitude
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldDescription="Decimal degrees, east positive. Between -180 and 180."
                                    fieldLabel="Longitude"
                                    max="{Double}180"
                                    min="{Double}-180"
                                    name="./longitude"
                                    step="0.0001"
                                    typeHint="Double"/>
                                <link
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldDescription="Optional facility page. Internal paths get .html appended automatically."
                                    fieldLabel="Links to"
                                    name="./link"
                                    rootPath="/content"/>
                            </items>
                        </field>
                    </locations>
                </items>
            </facilities>
        </items>
    </content>
</jcr:root>
