<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="MJ Feature"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <source
                jcr:primaryType="nt:unstructured"
                jcr:title="Source"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <variant
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldDescription="Which fragment model this feature reads, and how it is set."
                        fieldLabel="Variant"
                        name="./variant">
                        <items jcr:primaryType="nt:unstructured">
                            <insight
                                jcr:primaryType="nt:unstructured"
                                selected="{Boolean}true"
                                text="Insight"
                                value="insight"/>
                            <casestudy
                                jcr:primaryType="nt:unstructured"
                                text="Case study"
                                value="casestudy"/>
                        </items>
                    </variant>
                    <fragmentPath
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="The Content Fragment to feature."
                        fieldLabel="Content Fragment"
                        name="./fragmentPath"
                        required="{Boolean}true"
                        rootPath="/content/dam"/>
                    <eyebrow
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Names the section, e.g. Featured insight."
                        fieldLabel="Eyebrow"
                        name="./eyebrow"/>
                </items>
            </source>
            <overrides
                jcr:primaryType="nt:unstructured"
                jcr:title="Overrides"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <note
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/text"
                        text="Leave these empty to use the fragment's own fields. Fill one in only to change how this feature reads on this page — the fragment itself, and every other page using it, is untouched."/>
                    <titleOverride
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Headline"
                        name="./titleOverride"/>
                    <standfirstOverride
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                        fieldLabel="Standfirst"
                        name="./standfirstOverride"
                        rows="{Long}3"/>
                    <fileReferenceOverride
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="A wider crop of the same subject often works better at this size than the fragment's own hero image."
                        fieldLabel="Image"
                        name="./fileReferenceOverride"
                        rootPath="/content/dam"/>
                    <alt
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Leave empty when the image only sets a mood."
                        fieldLabel="Alternative text"
                        name="./alt"/>
                </items>
            </overrides>
            <action
                jcr:primaryType="nt:unstructured"
                jcr:title="Action"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <ctaText
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Link label"
                        name="./ctaText"/>
                    <ctaLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="The detail page for this fragment."
                        fieldLabel="Link"
                        name="./ctaLink"
                        rootPath="/content"/>
                </items>
            </action>
        </items>
    </content>
</jcr:root>
