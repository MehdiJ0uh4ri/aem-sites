<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="MJ Portfolio Grid"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container"
        margin="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <headingLevel
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                fieldDescription="Auto gives the h1 to whichever section opens the page and h2 to every section after it."
                fieldLabel="Heading level"
                name="./headingLevel">
                <items jcr:primaryType="nt:unstructured">
                    <auto jcr:primaryType="nt:unstructured" selected="{Boolean}true" text="Auto" value=""/>
                    <h1 jcr:primaryType="nt:unstructured" text="H1" value="h1"/>
                    <h2 jcr:primaryType="nt:unstructured" text="H2" value="h2"/>
                    <h3 jcr:primaryType="nt:unstructured" text="H3" value="h3"/>
                </items>
            </headingLevel>
            <eyebrow
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Eyebrow"
                name="./eyebrow"/>
            <heading
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Heading"
                name="./heading"/>
            <intro
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldLabel="Introduction"
                name="./intro"
                rows="{Long}2"/>
            <parentPath
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldDescription="Folder of Portfolio Company fragments. The filters are built from whatever is in it, so a new sector needs no dialog change."
                fieldLabel="Company folder"
                name="./parentPath"
                required="{Boolean}true"
                rootPath="/content/dam"/>
            <detailRoot
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldDescription="Page under which company detail pages live. Cards link to &lt;root&gt;/&lt;slug&gt;.html whether or not that page exists yet."
                fieldLabel="Detail pages root"
                name="./detailRoot"
                rootPath="/content"/>
            <showSecondaryFilters
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                checked="{Boolean}true"
                fieldDescription="Adds Stage and Year beside the sector row. Sector alone is often enough."
                name="./showSecondaryFilters"
                text="Show Stage and Year filters"
                uncheckedValue="false"
                value="{Boolean}true"/>
            <emptyText
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldDescription="Shown when a filter combination matches nothing."
                fieldLabel="Empty state message"
                name="./emptyText"/>
        </items>
    </content>
</jcr:root>
