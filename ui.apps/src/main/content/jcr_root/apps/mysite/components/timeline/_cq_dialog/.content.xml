<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Timeline"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Optional heading rendered above the sequence."
                        fieldLabel="Heading"
                        name="./heading"/>
                    <headingElement
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldDescription="HTML element used for the heading. Pick the one that fits the page outline."
                        fieldLabel="Heading element"
                        name="./headingElement">
                        <items jcr:primaryType="nt:unstructured">
                            <h2
                                jcr:primaryType="nt:unstructured"
                                selected="{Boolean}true"
                                text="H2"
                                value="h2"/>
                            <h3
                                jcr:primaryType="nt:unstructured"
                                text="H3"
                                value="h3"/>
                            <h4
                                jcr:primaryType="nt:unstructured"
                                text="H4"
                                value="h4"/>
                        </items>
                    </headingElement>
                    <entries
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="{Boolean}true"
                        fieldDescription="Milestones in the order they should be read, oldest first. Entries without a period are not rendered."
                        fieldLabel="Milestones">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./entries">
                            <items jcr:primaryType="nt:unstructured">
                                <period
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="A year, a quarter, or a span — for example 1994, Q3 2021 or 1994-97. Free text, because programme histories are rarely precise to the day."
                                    fieldLabel="Period"
                                    name="./period"
                                    required="{Boolean}true"/>
                                <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Milestone"
                                    name="./title"/>
                                <description
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Description"
                                    name="./description"
                                    rows="{Long}3"/>
                                <fileReference
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldDescription="Optional archival still from Assets."
                                    fieldLabel="Image"
                                    name="./fileReference"
                                    rootPath="/content/dam"/>
                                <alt
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="Leave empty when the milestone text already describes the image."
                                    fieldLabel="Alternative text"
                                    name="./alt"/>
                                <highlighted
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                    fieldDescription="Picks the milestone out of the sequence. Reserve it for genuine turning points — a first flight, a certification — or the emphasis stops meaning anything."
                                    name="./highlighted"
                                    text="Mark as a turning point"
                                    uncheckedValue="false"
                                    value="{Boolean}true"/>
                            </items>
                        </field>
                    </entries>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
