<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="MJ Engage"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container"
        margin="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <eyebrow
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Eyebrow"
                name="./eyebrow"/>
            <statement
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldDescription="The invitation itself. Understated — this is a door, not a pitch."
                fieldLabel="Statement"
                name="./statement"
                rows="{Long}2"/>
            <fileReference
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldDescription="Full-bleed ultra-wide crop behind the closing line. Leave empty for a plain dark close."
                fieldLabel="Backdrop"
                name="./fileReference"
                rootPath="/content/dam"/>
            <alt
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldDescription="Leave empty when the image only sets a mood, which here it usually does."
                fieldLabel="Alternative text"
                name="./alt"/>
            <items
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                composite="{Boolean}true"
                fieldDescription="One lane per audience. Two or three; a fourth dilutes all of them."
                fieldLabel="Lanes">
                <field
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container"
                    name="./items">
                    <items jcr:primaryType="nt:unstructured">
                        <audience
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldDescription="Who this lane addresses, e.g. Founders."
                            fieldLabel="Audience"
                            name="./audience"/>
                        <body
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            fieldLabel="Text"
                            name="./body"
                            rows="{Long}3"/>
                        <ctaText
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Link label"
                            name="./ctaText"/>
                        <ctaLink
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                            fieldLabel="Link"
                            name="./ctaLink"
                            rootPath="/content"/>
                    </items>
                </field>
            </items>
        </items>
    </content>
</jcr:root>
